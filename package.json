{
  "name": "my-remotion-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "lucide-react": "^1.62.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.7.0",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "npx remotion render PortfolioReels out/portfolio_reels_1080p.mp4 --pixel-format=yuv420p",
    "render:4k": "npx remotion render PortfolioReels out/portfolio_reels_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:template": "npx remotion render Template out/Template.mp4 --pixel-format=yuv420p",
    "render:http-vs-pubsub": "npx remotion render HttpVsPubSub out/HttpVsPubSub.mp4 --pixel-format=yuv420p",
    "render:http-vs-pubsub:4k": "npx remotion render HttpVsPubSub out/HttpVsPubSub_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:atasan-ai": "npx remotion render AtasanDikitDikitAI out/AtasanDikitDikitAI.mp4 --pixel-format=yuv420p",
    "render:atasan-ai:4k": "npx remotion render AtasanDikitDikitAI out/AtasanDikitDikitAI_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:rest-api": "npx remotion render RestApi out/RestApi.mp4 --pixel-format=yuv420p",
    "render:rest-api:4k": "npx remotion render RestApi out/RestApi_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:http-status-code": "npx remotion render HttpStatusCode out/HttpStatusCode.mp4 --pixel-format=yuv420p",
    "render:http-status-code:4k": "npx remotion render HttpStatusCode out/HttpStatusCode_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:storage-server": "npx remotion render StorageServer out/StorageServer.mp4 --pixel-format=yuv420p",
    "render:storage-server:4k": "npx remotion render StorageServer out/StorageServer_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:storege-server": "npm run render:storage-server",
    "render:fe-vs-be": "npx remotion render FrontendVsBackend out/FrontendVsBackend.mp4 --pixel-format=yuv420p",
    "render:fe-vs-be:4k": "npx remotion render FrontendVsBackend out/FrontendVsBackend_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18",
    "render:lyrics": "npx remotion render DontTestMeLyrics out/dont_test_me_lyrics_1080p.mp4 --pixel-format=yuv420p --muted",
    "render:lyrics:4k": "npx remotion render DontTestMeLyrics out/dont_test_me_lyrics_4k.mp4 --scale=2 --pixel-format=yuv420p --crf=18 --muted"
  },
  "allowScripts": {
    "esbuild": false
  }
}